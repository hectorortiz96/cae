# Local Docker testing environment
# Use with: docker-compose --env-file .env.local up

# MySQL
MYSQL_DATABASE=cae
MYSQL_USER=cae
MYSQL_PASSWORD=cae123
MYSQL_ROOT_PASSWORD=root123

# Backend Spring Boot
SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/cae?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8&useUnicode=true&connectionCollation=utf8mb4_unicode_ci
SPRING_DATASOURCE_USERNAME=cae
SPRING_DATASOURCE_PASSWORD=cae123
SECURITY_JWT_SECRET_KEY=local-dev-secret-key-for-testing
SECURITY_JWT_EXPIRATION_TIME=3600000
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
APP_MAIL_FROM=no-reply@cae.local
APP_MAIL_ENABLED=true
APP_PUBLIC_REPORT_BASE_URL=http://localhost:5173

# Frontend
VITE_API_BASE_URL=http://localhost:8080

